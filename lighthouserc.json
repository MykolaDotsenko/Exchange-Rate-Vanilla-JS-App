      "startServerCommand": "python3 -m http.server 4174 --bind 127.0.0.1",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://127.0.0.1:4174/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
